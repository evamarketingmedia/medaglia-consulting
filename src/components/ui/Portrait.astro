---
/**
 * Portrait — Alberto Medaglia's real photo as <picture> (AVIF / WebP / JPEG fallback) with
 * explicit width/height. No filters, no distortion: the frame crops with object-fit: cover
 * and a per-use object-position (`focus`), always keeping the face in view.
 */
import { PORTRAIT, portraitSrcset } from '../../content/portrait.ts';

interface Props {
  class?: string;
  sizes: string;
  /** CSS object-position, e.g. "30% 20%". */
  focus?: string;
  eager?: boolean;
}
const { class: className, sizes, focus = '30% 25%', eager = false } = Astro.props;
---
<picture class:list={['portrait', className]}>
  <source type="image/avif" srcset={portraitSrcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={portraitSrcset('webp')} sizes={sizes} />
  <img
    class="portrait__img"
    src={PORTRAIT.fallback}
    srcset={portraitSrcset('jpg')}
    sizes={sizes}
    alt={PORTRAIT.alt}
    width={PORTRAIT.width}
    height={PORTRAIT.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    style={`object-position: ${focus}`}
  />
</picture>
