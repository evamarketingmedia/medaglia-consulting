{
  "name": "medaglia-consulting-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Medaglia Consulting website (Astro, static). Phase 3B foundation only.",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "release-check": "node scripts/check-release.mjs",
    "release-check:production": "node scripts/check-release.mjs --mode=production"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
